# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development — zero config)
DATABASE_URL=sqlite+aiosqlite:///work/attendance.db

# PostgreSQL (production) — uncomment and set your credentials:
# DATABASE_URL=postgresql+psycopg://attendance:yourpassword@localhost:5432/attendance

# Docker Compose password override (used by docker-compose.yml)
# DB_PASSWORD=yourpassword

# ── File storage ──────────────────────────────────────────────────────────────
SPOOL_DIR=work/spool
MAX_UPLOAD_BYTES=1048576

# ── Database connection pool (PostgreSQL only) ────────────────────────────────
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=3
DB_POOL_RECYCLE_SECONDS=1800

# ── Batch worker ──────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=1.0

# ── AI models — download with: python -m worker.download_models ───────────────
FACE_DETECTION_MODEL_PATH=work/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=work/models/w600k_mbf.onnx
WORKER_MODEL_VERSION=arcface-mbf
EMBEDDING_DIMENSIONS=512

# ── Face matching ─────────────────────────────────────────────────────────────
DETECTION_SCORE_THRESHOLD=0.60
# ArcFace cosine similarity threshold (0.0 – 1.0). Range 0.28 – 0.45 typical.
# Raise to reduce false positives; lower to reduce false negatives.
MATCH_THRESHOLD=0.35

# ── Per-demographic thresholds (optional fairness tuning) ─────────────────────
# Lower a group's threshold if its recognition rate is significantly below others.
# RACE_THRESHOLDS={"black": 0.30, "east_asian": 0.33}

# ── Misc ──────────────────────────────────────────────────────────────────────
# Set to false in production when using Alembic or manual migrations
AUTO_CREATE_TABLES=true
