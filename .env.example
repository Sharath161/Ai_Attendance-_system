# ── Face Recognition API configuration (prefix FACEAPI_) ─────────────────────

# Matching — calibrate for your domain: python -m faceapi.calibrate
FACEAPI_MATCH_THRESHOLD=0.42

# Accuracy: flip test-time augmentation (2x embed cost)
FACEAPI_ENABLE_TTA=false
# Few-shot: expand each enrolment photo into ~6 augmented embeddings
FACEAPI_ENROLL_AMPLIFY=true

# Low-resource / edge
FACEAPI_USE_INT8=false          # quantized model: ~3.9x smaller (benchmark on target)
FACEAPI_INTRA_OP_THREADS=0      # 0 = auto; set e.g. 4 on a Raspberry Pi
FACEAPI_DETECT_MAX_SIDE=0       # e.g. 320 to downscale for detection only

# Security — comma-separated keys required in the X-API-Key header (empty = off)
FACEAPI_API_KEYS=
# Comma-separated allowed CORS origins (empty = "*", lock down in production)
FACEAPI_CORS_ORIGINS=

# Storage
FACEAPI_DB_PATH=work/faceapi.db

# Server
FACEAPI_HOST=0.0.0.0
FACEAPI_PORT=8080
