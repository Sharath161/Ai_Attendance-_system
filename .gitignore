# ── Runtime data — biometric PII / secrets (NEVER commit) ─────────────────────
# NOTE: git only treats '#' as a comment at the start of a line, so keep
# every ignore pattern on its own line with no trailing inline comment.
work/spool/
# real face photos of real people (biometric PII):
work/registrations/
# diagnostic webcam snapshots (real photos):
work/diag/
# your own test photos of real people (biometric PII) — keep only the guide:
work/my_people/*
!work/my_people/README.txt
work/logs/
# 51 MB ONNX weights — re-fetch with: python -m worker.download_models
work/models/
# personal records + face-embedding templates:
work/attendance.db
work/attendance.db-shm
work/attendance.db-wal

